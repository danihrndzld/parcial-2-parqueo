meta {
  name: Abrir ticket
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

body:json {
  {
    "placa": "p123abc",
    "entrada": "2026-10-22T08:00:00"
  }
}

assert {
  res.status: eq 201
  res.body.placa: eq P123ABC
  res.body.monto: isNull
}

script:post-response {
  bru.setVar("ticketId", res.body.id);
}

tests {
  test("Location apunta al ticket creado", function() {
    expect(res.getHeader("location")).to.equal("/tickets/" + res.getBody().id);
  });
}
